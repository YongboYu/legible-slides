<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The file's own metadata, and where the non-endorsement note travels.

  `dc:description` is the sentence `themes/kuleuven.json` already carries in its own `meta`, quoted
  rather than reworded: a .pptx leaves this repo on its own, and the note has to leave with it. The
  test suite holds the two to each other, so the theme file stays the place the sentence is written.

  No `dcterms:created` and no `dcterms:modified`. A timestamp would make the packed file differ from
  itself on every run, and the check that the shipped .pptx is current turns on packing it twice and
  getting the same bytes.
-->
<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:dcmitype="http://purl.org/dc/dcmitype/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <dc:creator>Yongbo Yu</dc:creator>
  <dc:description>KU Leuven house-style-derived theme. Not an official KU Leuven product and carries no endorsement.</dc:description>
  <cp:lastModifiedBy>Yongbo Yu</cp:lastModifiedBy>
  <cp:revision>1</cp:revision>
  <dc:subject>The legible-slides method, in a native PowerPoint master</dc:subject>
  <dc:title>legible-slides — PowerPoint static proof</dc:title>
</cp:coreProperties>
