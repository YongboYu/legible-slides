<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The deck: one master, four slides, and both typefaces travelling inside the file.

  `embedTrueTypeFonts="1"` with `saveSubsetFonts="0"` ships the whole face rather than the glyphs
  these four slides happen to use, which is the difference between a presenter being able to edit
  the deck on a strange machine and being able only to look at it. Inter and JetBrains Mono are both
  SIL OFL, so embedding them is a licence the file carries rather than one it borrows.

  Three faces, not five. PowerPoint's embedding slots are regular / bold / italic / bold-italic per
  typeface, so the theme's Medium and SemiBold have nowhere to go and a bold headline here is
  Inter Bold where the Slidev delivery sets it in SemiBold. That is the one place the two deliveries
  differ by design; `pptx/README.md` records it.

  The `panose` / `pitchFamily` / `charset` triple beside each name is the declared fallback, for the
  renderers — Mac PowerPoint, the web viewer — that strip embeddings. ppt/theme/theme1.xml carries
  the same triple and says what each byte means.

  The slide is 12192000 × 6858000 EMU: 13.333″ × 7.5″, which is 16:9 — the canon's
  `canvas-aspect-ratio`, in the units PowerPoint measures a slide in.
-->
<p:presentation xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" saveSubsetFonts="0" embedTrueTypeFonts="1" strictFirstAndLastChars="0">
  <p:sldMasterIdLst>
    <p:sldMasterId id="2147483648" r:id="rId1"/>
  </p:sldMasterIdLst>
  <p:sldIdLst>
    <p:sldId id="256" r:id="rId2"/>
    <p:sldId id="257" r:id="rId3"/>
    <p:sldId id="258" r:id="rId4"/>
    <p:sldId id="259" r:id="rId5"/>
  </p:sldIdLst>
  <p:sldSz cx="12192000" cy="6858000"/>
  <p:notesSz cx="6858000" cy="9144000"/>
  <p:embeddedFontLst>
    <p:embeddedFont>
      <p:font typeface="Inter" panose="02000503000000020004" pitchFamily="34" charset="0"/>
      <p:regular r:id="rId10"/>
      <p:bold r:id="rId11"/>
    </p:embeddedFont>
    <p:embeddedFont>
      <p:font typeface="JetBrains Mono" panose="02000009000000000000" pitchFamily="49" charset="0"/>
      <p:regular r:id="rId12"/>
    </p:embeddedFont>
  </p:embeddedFontLst>
  <p:defaultTextStyle>
    <a:lvl1pPr marL="0" indent="0" algn="l">
      <a:defRPr sz="1800">
        <a:solidFill><a:schemeClr val="tx1"/></a:solidFill>
        <a:latin typeface="+mn-lt"/>
      </a:defRPr>
    </a:lvl1pPr>
  </p:defaultTextStyle>
</p:presentation>
