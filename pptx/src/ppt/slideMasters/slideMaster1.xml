<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The Slide Master: the five zones of `ae-skeleton`, once, for every content layout under it.

  The shapes below are written in the order the rule states them —

      locator  →  assertion headline  →  accent rule  →  evidence  →  page number

  — and three of them are placeholders rather than drawings, because three of them are a presenter's
  to edit. The locator is PowerPoint's `ftr` placeholder and the page number is its `sldNum` one,
  which is what makes them inherited by every content layout, editable per slide, and switchable
  from the Header & Footer dialog a PowerPoint user already knows. The accent rule is not a
  placeholder: it is a rule, and nothing about it is a presenter's to type into.

  The cover opts out of all of it — see slideLayout1.xml. That is the native equivalent of the
  theme's `global-*` opt-out: chrome lives here, and a layout declines it rather than each layout
  asking for it.

  Every geometry number is a canvas px from `theme/styles/layout.css`, converted once. The canon's
  canvas and a 16:9 PowerPoint slide are the same shape, and one canvas px comes to a whole number
  of EMU, so the zones land where the Slidev delivery draws them rather than near it.

  No colour is written here but `hairline`. Everything else is a theme slot, so recolouring the
  proof is ppt/theme/theme1.xml and nothing else — `docs/pptx-static-proof.md` §4 records why the
  hairline is the exception.
-->
<p:sldMaster xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" preserve="1">
  <p:cSld>
    <p:bg>
      <p:bgPr>
        <a:solidFill><a:schemeClr val="bg1"/></a:solidFill>
        <a:effectLst/>
      </p:bgPr>
    </p:bg>
    <p:spTree>
      <p:nvGrpSpPr>
        <p:cNvPr id="1" name=""/>
        <p:cNvGrpSpPr/>
        <p:nvPr/>
      </p:nvGrpSpPr>
      <p:grpSpPr>
        <a:xfrm>
          <a:off x="0" y="0"/><a:ext cx="0" cy="0"/>
          <a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/>
        </a:xfrm>
      </p:grpSpPr>

      <!-- 1. Locator. The orientation device `no-section-dividers` relies on: it is on every
           content slide, so no slide has to be spent announcing where the talk has got to. A
           presenter retypes it when the section changes and leaves it alone otherwise. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="2" name="Locator"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="ftr" sz="quarter" idx="10"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="342900"/><a:ext cx="1600200" cy="266700"/></a:xfrm>
          <a:prstGeom prst="roundRect"><a:avLst><a:gd name="adj" fmla="val 50000"/></a:avLst></a:prstGeom>
          <a:solidFill><a:schemeClr val="accent1"/></a:solidFill>
          <a:ln><a:noFill/></a:ln>
        </p:spPr>
        <p:txBody>
          <!-- Hugs its text. `wrap="none"` with autofit is what makes PowerPoint refit the pill to
               a retyped section name rather than leave a brand-coloured slab behind a short one;
               the extent each slide carries is that fit, written down, so a renderer that does not
               refit still draws the pill at the size its own text needs. -->
          <a:bodyPr wrap="none" lIns="133350" tIns="0" rIns="133350" bIns="0" anchor="ctr"><a:spAutoFit/></a:bodyPr>
          <a:lstStyle>
            <a:lvl1pPr algn="l">
              <a:defRPr sz="1200" b="0" spc="48">
                <a:solidFill><a:schemeClr val="bg1"/></a:solidFill>
                <a:latin typeface="JetBrains Mono" panose="02000009000000000000" pitchFamily="49" charset="0"/>
              </a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>The section</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <!-- 2. Assertion headline. Two rendered lines is the ceiling `headline-shape` sets, and the
           zone is that ceiling in height: a third line has nowhere to go and would collide with
           the accent rule below it. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="3" name="Assertion headline"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="title"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="800100"/><a:ext cx="10820400" cy="902208"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr>
          <a:lstStyle/>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Write the claim this slide proves, as a sentence</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <!-- 3. Accent rule. Two rectangles rather than one bordered shape, because the accent segment
           that starts it is the attention mark (`accent-is-attention`) and the rest of the line is
           a hairline. `hairline` is a fixed fill: it is the one palette role with no theme slot to
           live in, which `docs/pptx-static-proof.md` §4 records. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="4" name="Rule"/>
          <p:cNvSpPr/>
          <p:nvPr/>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="1892808"/><a:ext cx="10820400" cy="28575"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
          <a:solidFill><a:srgbClr val="DDE5EE"/></a:solidFill>
          <a:ln><a:noFill/></a:ln>
        </p:spPr>
        <p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang="en-GB"/></a:p></p:txBody>
      </p:sp>
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="5" name="Rule accent"/>
          <p:cNvSpPr/>
          <p:nvPr/>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="1892808"/><a:ext cx="838200" cy="28575"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
          <a:solidFill><a:schemeClr val="accent2"/></a:solidFill>
          <a:ln><a:noFill/></a:ln>
        </p:spPr>
        <p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang="en-GB"/></a:p></p:txBody>
      </p:sp>

      <!-- 4. Evidence. What proves the headline, and the only zone a layout re-cuts: the two-column
           layout splits this rectangle, and nothing else about the skeleton moves. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="6" name="Evidence"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="body" idx="1"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="2111883"/><a:ext cx="10820400" cy="4136517"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr>
          <a:lstStyle/>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Prove it, visually</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <!-- 5. Page number. PowerPoint's own field, so it counts the deck rather than being typed. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="7" name="Page number"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="sldNum" sz="quarter" idx="12"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="6248400"/><a:ext cx="10820400" cy="266700"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="b"/>
          <a:lstStyle>
            <a:lvl1pPr algn="r">
              <a:defRPr sz="1200"><a:solidFill><a:schemeClr val="tx2"/></a:solidFill></a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <a:p>
            <a:fld id="{4B2C0E1A-6D3F-4A97-9F1B-2E5C7A8D0B31}" type="slidenum">
              <a:rPr lang="en-GB"/>
              <a:t>2</a:t>
            </a:fld>
            <a:endParaRPr lang="en-GB"/>
          </a:p>
        </p:txBody>
      </p:sp>
    </p:spTree>
  </p:cSld>
  <p:clrMap bg1="lt1" tx1="dk1" bg2="lt2" tx2="dk2" accent1="accent1" accent2="accent2" accent3="accent3" accent4="accent4" accent5="accent5" accent6="accent6" hlink="hlink" folHlink="folHlink"/>
  <p:sldLayoutIdLst>
    <p:sldLayoutId id="2147483649" r:id="rId1"/>
    <p:sldLayoutId id="2147483650" r:id="rId2"/>
    <p:sldLayoutId id="2147483651" r:id="rId3"/>
    <p:sldLayoutId id="2147483652" r:id="rId4"/>
  </p:sldLayoutIdLst>
  <!-- No transition and no timing: `motion-purpose` earns motion two ways, and neither of them is
       a slide change. The deck's whole animation budget is a speaker-paced reveal, which is a
       per-slide decision rather than a default the master hands out. -->
  <p:hf hdr="0" dt="0"/>
  <!--
    The type scale, in points, and the only place the proof states a size.

    `type-scale` fixes the sizes on the canon's logical canvas; a PowerPoint slide is a smaller share
    of the same shape, so a point size here is the canvas px scaled by the ratio of the two heights,
    taken up to the next even point. Up rather than to the nearest, because up is the direction that
    cannot land under the ratio whatever the canon's sizes are next year.

    The numbers below are `headline-px` and `body-px`; the two dense exceptions are set where they
    are taken. The canon owns all four, `docs/pptx-static-proof.md` §5 records the conversion, and
    python/tests/test_pptx.py re-derives every one of them from `docs/method.md` — so this file is
    the only copy, and it is a checked one.
  -->
  <p:txStyles>
    <p:titleStyle>
      <a:lvl1pPr algn="l">
        <a:lnSpc><a:spcPct val="128000"/></a:lnSpc>
        <a:defRPr sz="2800" b="1" spc="-28">
          <a:solidFill><a:schemeClr val="accent1"/></a:solidFill>
          <a:latin typeface="+mj-lt"/>
        </a:defRPr>
      </a:lvl1pPr>
    </p:titleStyle>
    <p:bodyStyle>
      <!-- No per-level scale. Assertion-Evidence has one headline size, one body size and the
           locator; a heading scale is how a deck drifts below the floor one slide at a time. The
           nine levels exist because PowerPoint's outliner offers them, and they are all one size. -->
      <a:lvl1pPr marL="0" indent="0" algn="l">
        <a:lnSpc><a:spcPct val="150000"/></a:lnSpc>
        <a:spcBef><a:spcPts val="0"/></a:spcBef>
        <a:buNone/>
        <a:defRPr sz="1800">
          <a:solidFill><a:schemeClr val="tx1"/></a:solidFill>
          <a:latin typeface="+mn-lt"/>
        </a:defRPr>
      </a:lvl1pPr>
      <a:lvl2pPr marL="342900" indent="-342900" algn="l">
        <a:lnSpc><a:spcPct val="145000"/></a:lnSpc>
        <a:spcBef><a:spcPts val="600"/></a:spcBef>
        <a:buClr><a:schemeClr val="tx2"/></a:buClr>
        <a:buChar char="▪"/>
        <a:defRPr sz="1800">
          <a:solidFill><a:schemeClr val="tx1"/></a:solidFill>
          <a:latin typeface="+mn-lt"/>
        </a:defRPr>
      </a:lvl2pPr>
    </p:bodyStyle>
    <p:otherStyle>
      <a:lvl1pPr marL="0" indent="0" algn="l">
        <a:defRPr sz="1800">
          <a:solidFill><a:schemeClr val="tx1"/></a:solidFill>
          <a:latin typeface="+mn-lt"/>
        </a:defRPr>
      </a:lvl1pPr>
    </p:otherStyle>
  </p:txStyles>
</p:sldMaster>
