<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The palette and the two families, as PowerPoint's own theme.

  This is the one part of the package that writes a palette hex down. Everything else references a
  slot — `accent1`, `tx2`, `bg1` — so recolouring the proof is this file and nothing else, the same
  bargain `theme/styles/tokens.css` strikes for the Slidev delivery. The twelve slots and what each
  carries are the mapping in `docs/pptx-static-proof.md` §4, hand-set once; nothing derives them
  from `themes/kuleuven.json`, and `python/tests/test_pptx.py` is what holds the copy to the
  original.

  The data-encoding series is deliberately absent. It overflows the six accents, and it does not
  need them: figures are regenerated and imported as validated pictures, so `series-1 … series-3`
  live inside those images rather than in any native shape here.
-->
<a:theme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="legible — kuleuven">
  <a:themeElements>
    <a:clrScheme name="legible — kuleuven">
      <!-- Text 1 / Background 1: `ink` on `surface`. `light-ground` is locked, so this pairing is
           not a scheme a viewer chooses between. -->
      <a:dk1><a:srgbClr val="102A43"/></a:dk1>
      <a:lt1><a:srgbClr val="FFFFFF"/></a:lt1>
      <!-- Text 2 / Background 2: `neutral` on `surface-alt`. -->
      <a:dk2><a:srgbClr val="486581"/></a:dk2>
      <a:lt2><a:srgbClr val="F4F7FB"/></a:lt2>
      <a:accent1><a:srgbClr val="00407A"/></a:accent1>
      <!-- `accent`, which `accent-is-attention` governs here exactly as it does in the deck: an
           arrow, a highlight, "ours" — never a data series. -->
      <a:accent2><a:srgbClr val="DD8A2E"/></a:accent2>
      <a:accent3><a:srgbClr val="1D8DB0"/></a:accent3>
      <a:accent4><a:srgbClr val="93A4B8"/></a:accent4>
      <!-- `reference` and `muted`, present only so a presenter has swatches matching the figures —
           a legend chip, a callout on a chart. The data itself always arrives as a picture. -->
      <a:accent5><a:srgbClr val="111111"/></a:accent5>
      <a:accent6><a:srgbClr val="778496"/></a:accent6>
      <a:hlink><a:srgbClr val="1D8DB0"/></a:hlink>
      <a:folHlink><a:srgbClr val="778496"/></a:folHlink>
    </a:clrScheme>
    <!--
      `fonts`: one text family, one mono family. Both are embedded in the package (see
      ppt/presentation.xml), and the three attributes beside a name are the fallback OOXML actually
      understands — a renderer that has neither the face nor the embedding substitutes on them
      rather than on whatever is first in its own list.

        panose        the face's own metric fingerprint, read out of the shipped TTF
        pitchFamily   34 = variable pitch, Swiss → a generic sans stands in for Inter
                      49 = fixed pitch, Modern   → a mono stands in for JetBrains Mono
        charset       0 = ANSI

      A font scheme has two slots and they are the heading face and the body face, so both are Inter
      here: `fonts` gives the mono family one job, and it is the locator. JetBrains Mono is declared
      where it is actually set — on the locator placeholder in slideMaster1.xml, and on its own
      embedding entry — with the same three attributes. Putting it in `minorFont` would set every
      word of every slide in it.
    -->
    <a:fontScheme name="legible">
      <a:majorFont>
        <a:latin typeface="Inter" panose="02000503000000020004" pitchFamily="34" charset="0"/>
        <a:ea typeface=""/>
        <a:cs typeface=""/>
      </a:majorFont>
      <a:minorFont>
        <a:latin typeface="Inter" panose="02000503000000020004" pitchFamily="34" charset="0"/>
        <a:ea typeface=""/>
        <a:cs typeface=""/>
      </a:minorFont>
    </a:fontScheme>
    <!--
      Flat, on purpose. The style lists below are what PowerPoint reaches for when a shape is given
      a "style" rather than an explicit fill: gradients, bevels, shadows and a soft glow are the
      chrome `figure-noise` and `coherence` spend no ink on, so every level of every list here is
      the plainest thing the schema permits. A shape built from this theme cannot arrive decorated.
    -->
    <a:fmtScheme name="legible">
      <a:fillStyleLst>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
      </a:fillStyleLst>
      <a:lnStyleLst>
        <a:ln w="9525" cap="flat" cmpd="sng" algn="ctr">
          <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
          <a:prstDash val="solid"/>
        </a:ln>
        <a:ln w="19050" cap="flat" cmpd="sng" algn="ctr">
          <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
          <a:prstDash val="solid"/>
        </a:ln>
        <a:ln w="28575" cap="flat" cmpd="sng" algn="ctr">
          <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
          <a:prstDash val="solid"/>
        </a:ln>
      </a:lnStyleLst>
      <a:effectStyleLst>
        <a:effectStyle><a:effectLst/></a:effectStyle>
        <a:effectStyle><a:effectLst/></a:effectStyle>
        <a:effectStyle><a:effectLst/></a:effectStyle>
      </a:effectStyleLst>
      <a:bgFillStyleLst>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
        <a:solidFill><a:schemeClr val="phClr"/></a:solidFill>
      </a:bgFillStyleLst>
    </a:fmtScheme>
  </a:themeElements>
  <a:objectDefaults/>
  <a:extraClrSchemeLst/>
</a:theme>
