<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Cover — mirrors the theme's `cover` layout, and is the one layout with no chrome.

  `showMasterSp="0"` drops the master's drawn shapes and the `p:hf` below switches off both of its
  chrome placeholders, so the locator, the accent rule and the page number are all absent. That is
  the whole opt-out: the cover is where orientation begins rather than something the locator has to
  carry, and a presenter gets it by choosing this layout rather than by deleting three shapes.

  The mark is a picture on the layout rather than on the slide, so a second cover made from this
  layout arrives wearing it and a brand swap is one replacement in one place.

  It introduces no new type size — the title is set at the headline size, because a cover is not a
  licence for a display face.
-->
<p:sldLayout xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" type="title" preserve="1" showMasterSp="0">
  <p:cSld name="Cover">
    <p:spTree>
      <p:nvGrpSpPr>
        <p:cNvPr id="1" name=""/>
        <p:cNvGrpSpPr/>
        <p:nvPr/>
      </p:nvGrpSpPr>
      <p:grpSpPr>
        <a:xfrm>
          <a:off x="0" y="0"/><a:ext cx="0" cy="0"/>
          <a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/>
        </a:xfrm>
      </p:grpSpPr>

      <p:pic>
        <p:nvPicPr>
          <p:cNvPr id="2" name="Mark"/>
          <p:cNvPicPr><a:picLocks noChangeAspect="1"/></p:cNvPicPr>
          <p:nvPr/>
        </p:nvPicPr>
        <p:blipFill>
          <a:blip r:embed="rId2"/>
          <a:stretch><a:fillRect/></a:stretch>
        </p:blipFill>
        <p:spPr>
          <!-- Top-right, on the line the locator pill sits on opposite it. -->
          <a:xfrm><a:off x="9029700" y="342900"/><a:ext cx="2476500" cy="335896"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
      </p:pic>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="3" name="Title"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="ctrTitle"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="2324100"/><a:ext cx="10820400" cy="457200"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr>
          <a:lstStyle/>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>The deck</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="4" name="Subtitle"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="subTitle" idx="1"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="2895600"/><a:ext cx="10820400" cy="323850"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr>
          <a:lstStyle>
            <a:lvl1pPr marL="0" indent="0" algn="l">
              <a:lnSpc><a:spcPct val="145000"/></a:lnSpc>
              <a:buNone/>
              <a:defRPr sz="1800" b="0">
                <a:solidFill><a:schemeClr val="tx2"/></a:solidFill>
                <a:latin typeface="+mn-lt"/>
              </a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>What it is for, in one sentence</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <!-- The cover's own accent segment. Not the master's rule — that is chrome, and this slide
           carries none; this is the same 88 px mark standing on its own. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="5" name="Rule accent"/>
          <p:cNvSpPr/>
          <p:nvPr/>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="3524250"/><a:ext cx="838200" cy="28575"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
          <a:solidFill><a:schemeClr val="accent2"/></a:solidFill>
          <a:ln><a:noFill/></a:ln>
        </p:spPr>
        <p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang="en-GB"/></a:p></p:txBody>
      </p:sp>

      <!-- Who is speaking, where, and when. Data rather than prose, which is why it is its own
           zone instead of a second paragraph of the subtitle. -->
      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="6" name="Speaker and venue"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="body" idx="2"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr>
          <a:xfrm><a:off x="685800" y="3857625"/><a:ext cx="10820400" cy="695325"/></a:xfrm>
          <a:prstGeom prst="rect"><a:avLst/></a:prstGeom>
        </p:spPr>
        <p:txBody>
          <a:bodyPr lIns="0" tIns="0" rIns="0" bIns="0" anchor="t"><a:noAutofit/></a:bodyPr>
          <a:lstStyle>
            <a:lvl1pPr marL="0" indent="0" algn="l">
              <a:buNone/>
              <a:defRPr sz="1800">
                <a:solidFill><a:schemeClr val="tx2"/></a:solidFill>
                <a:latin typeface="+mn-lt"/>
              </a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Speaker</a:t></a:r></a:p>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Venue</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>
    </p:spTree>
  </p:cSld>
  <p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr>
  <p:hf sldNum="0" hdr="0" ftr="0" dt="0"/>
</p:sldLayout>
