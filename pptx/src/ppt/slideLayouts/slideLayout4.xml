<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  References — mirrors the theme's `references` layout.

  A slide about sources, not a divider: it proves something — where the claims came from — which is
  why the method can ship it while refusing a section slide (`no-section-dividers`).

  The one thing it adds to the skeleton is the numbering. Entries are an auto-numbered list so a
  `1` beside a claim earlier in the deck lines up with an entry here without anybody renumbering by
  hand, and the numerals take `neutral` rather than the softest neutral because numerals are text
  (`decorative-neutral-never-text`).
-->
<p:sldLayout xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" type="obj" preserve="1">
  <p:cSld name="References">
    <p:spTree>
      <p:nvGrpSpPr>
        <p:cNvPr id="1" name=""/>
        <p:cNvGrpSpPr/>
        <p:nvPr/>
      </p:nvGrpSpPr>
      <p:grpSpPr>
        <a:xfrm>
          <a:off x="0" y="0"/><a:ext cx="0" cy="0"/>
          <a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/>
        </a:xfrm>
      </p:grpSpPr>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="2" name="Locator"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="ftr" sz="quarter" idx="10"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr/>
        <p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:endParaRPr lang="en-GB"/></a:p></p:txBody>
      </p:sp>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="3" name="Assertion headline"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="title"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr/>
        <p:txBody>
          <a:bodyPr/>
          <a:lstStyle/>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Write the claim this slide proves, as a sentence</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="4" name="Sources"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="body" idx="1"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr/>
        <p:txBody>
          <a:bodyPr/>
          <a:lstStyle>
            <a:lvl1pPr marL="525780" indent="-525780" algn="l">
              <a:lnSpc><a:spcPct val="140000"/></a:lnSpc>
              <a:spcBef><a:spcPts val="700"/></a:spcBef>
              <!-- Without a stop of its own the tab after the numeral runs on to the next default
                   one, and an entry's first line starts to the right of the lines it wraps onto. -->
              <a:tabLst><a:tab pos="525780" algn="l"/></a:tabLst>
              <a:buClr><a:schemeClr val="tx2"/></a:buClr>
              <a:buFont typeface="+mn-lt"/>
              <a:buAutoNum type="arabicPeriod"/>
              <a:defRPr sz="1800">
                <a:solidFill><a:schemeClr val="tx1"/></a:solidFill>
                <a:latin typeface="+mn-lt"/>
              </a:defRPr>
            </a:lvl1pPr>
          </a:lstStyle>
          <a:p><a:r><a:rPr lang="en-GB"/><a:t>Author, year, title</a:t></a:r></a:p>
        </p:txBody>
      </p:sp>

      <p:sp>
        <p:nvSpPr>
          <p:cNvPr id="5" name="Page number"/>
          <p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>
          <p:nvPr><p:ph type="sldNum" sz="quarter" idx="12"/></p:nvPr>
        </p:nvSpPr>
        <p:spPr/>
        <p:txBody>
          <a:bodyPr/>
          <a:lstStyle/>
          <a:p>
            <a:fld id="{4B2C0E1A-6D3F-4A97-9F1B-2E5C7A8D0B31}" type="slidenum">
              <a:rPr lang="en-GB"/>
              <a:t>2</a:t>
            </a:fld>
            <a:endParaRPr lang="en-GB"/>
          </a:p>
        </p:txBody>
      </p:sp>
    </p:spTree>
  </p:cSld>
  <p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr>
</p:sldLayout>
