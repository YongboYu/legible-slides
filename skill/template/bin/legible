#!/bin/sh
# The checks this deck is held to, at the release of legible-slides its theme is pinned to.
#
# Run every check through here: the hooks, the workflow, and an agent reviewing the deck. A deck
# pinned to one release is then never checked against another's rules by whatever `legible`
# happens to be on PATH, and `bin/legible rules` prints the rules the deck was built to.
#
#     bin/legible lint slides.md --theme themes/palette.json
#     bin/legible rules one-message
#     bin/cvd-validate themes/palette.json
#
# VERSION is the release, and package.json pins slidev-theme-legible to the same one. To take a
# later release, change both together. The first run installs the checks from PyPI; uv caches
# them, so every run after that starts right away.
#
# LEGIBLE_FROM installs the checks from somewhere else, such as a wheel you built yourself.
set -eu

VERSION=0.1.0
FROM=${LEGIBLE_FROM:-legible-slides==$VERSION}

if ! command -v uvx >/dev/null 2>&1; then
  echo "bin/legible: needs uv, which installs the pinned checks — https://docs.astral.sh/uv/" >&2
  exit 2
fi

exec uvx --quiet --from "$FROM" "${LEGIBLE_TOOL:-legible}" "$@"
