{
  "name": "my-deck",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A talk, built to the legible-slides method.",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md --base ./ --out dist",
    "export": "slidev export slides.md --format pdf --output dist/slides.pdf",
    "render": "slidev export slides.md --format png --with-clicks --output render"
  },
  "dependencies": {
    "slidev-theme-legible": "0.1.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "playwright-chromium": "^1.62.0"
  },
  "pnpm": {
    "overrides": {
      "markdown-it": "^14.1.0",
      "unocss": "~66.7.5"
    }
  }
}
