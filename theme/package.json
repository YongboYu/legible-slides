{
  "name": "slidev-theme-legible",
  "version": "0.1.0",
  "type": "module",
  "description": "Assertion-Evidence layouts, persistent chrome and tokenised styles for legible-slides.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YongboYu/legible-slides.git",
    "directory": "theme"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "assertion-evidence",
    "accessibility"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "slidev": ">=52.0.0"
  },
  "files": [
    "assets/fonts/*.woff2",
    "assets/fonts/*.txt",
    "assets/fonts/README.md",
    "assets/placeholders",
    "components",
    "layouts",
    "styles",
    "utils",
    "slide-top.vue"
  ],
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "fonts": {
        "sans": "Inter",
        "mono": "JetBrains Mono",
        "local": [
          "Inter",
          "JetBrains Mono"
        ],
        "provider": "none"
      }
    }
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/types": "^52.18.0"
  }
}
